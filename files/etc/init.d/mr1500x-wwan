#!/bin/sh /etc/rc.common
# MR1500X / MR60Xv2 — join an upstream Wi-Fi network as a CLIENT (wwan uplink).
#
# SHIPPED DISABLED AND WITHOUT CREDENTIALS. This is plumbing, not a default:
# `/etc/config/mr1500x-wifi` has `option enabled '0'` and empty ssid/key, so a
# freshly flashed unit does not associate with anything. Configure it on the
# device (uci, or LuCI's config editor) — do not bake credentials into an image.
#
# WHAT IT DOES
#   Runs wpa_supplicant on the 2.4 GHz STA vdev (wlan1-vxd) and, once the link
#   is up, hands the interface to netifd (`ifup wwan`) so DHCP, the default
#   route and resolv.conf are managed the normal OpenWrt way.
#
#   The LAN side is untouched: br-lan keeps 192.168.1.1 and dnsmasq keeps
#   serving DHCP there. /etc/config/dhcp marks wwan `ignore 1`, so this box is
#   a DHCP *client* upstream and a DHCP *server* downstream, never the reverse.
#
# WHY NOT netifd/wifi-iface
#   The same reason the AP is hand-rolled: OpenWrt's mac80211.sh calls
#   `iw phy <phy> interface add`, which hangs this driver until a POWER CYCLE.
#   wlan1-vxd already exists (the vendor driver pre-creates the vdevs), so the
#   supplicant is pointed straight at it and no interface is ever created.
#
# WHY `ifup wwan` ALONE IS NOT ENOUGH  (netifd + phy80211)
#   netifd REFUSES to instantiate any netdev that has a /sys/class/net/<dev>/
#   phy80211 link — it considers such devices to belong to its own wireless
#   subsystem, which is exactly the subsystem we cannot use here. The symptom is
#   total silence: `ifstatus wwan` reports NO_DEVICE forever, netifd logs
#   nothing, and `ubus call network.device status '{"name":"wlan1-vxd"}'` fails
#   with "Invalid argument" because no device object was ever created. The very
#   same interface config pointed at a non-wireless device (eth1) comes up fine,
#   so it is the wireless-ness, not the config.
#
#   The fix is the mechanism netifd's own wireless layer uses to hand it an
#   externally-managed vdev: `add_device` on the interface, which attaches the
#   netdev as an external device (netifd then runs DHCP on it but never tries to
#   create, configure or tear it down). That is what associate_and_attach() does
#   below, and it must happen BEFORE `ifup`.
#
# HARD-WON INVOCATION DETAILS (see AGENTS.md)
#   - the SSID must be written as HEX. Quoted ASCII silently fails to match the
#     network on this old Realtek fork.
#   - do NOT pass -B. Self-daemonising dies here; background it from the shell
#     and redirect its output, or it holds the caller's terminal open.
#   - run it as /usr/sbin/wpa_supplicant (a symlink to the multi-call wpad).
#     `wpad` alone answers "Invalid command"; it dispatches on argv[0].
#   - wpad on this image has NO wpa_passphrase applet, so a plaintext
#     passphrase is written as psk="..." and wpa_supplicant derives the key
#     itself. A 64-hex PSK in `option key` also works and is passed through
#     unquoted. Both forms are equivalent — if one fails the other fails too, so
#     a 4-way that never completes means the PASSPHRASE IS WRONG (that is what
#     it turned out to be here), not that the encoding needs changing.
#
# The radio is shared with the 2.4 GHz AP, so associating with an upstream AP
# on another channel will drag our own AP to that channel. That is how repeater
# mode works on this chip; it is not a bug to chase.

START=36
STOP=16

CONF=/var/run/mr1500x-wwan.conf
PIDF=/var/run/mr1500x-wwan.pid
LOGF=/var/log/mr1500x-wwan.log

wlog() { logger -t mr1500x-wwan "$@"; }

is_hex_psk() {
	# exactly 64 hex digits = a pre-derived PSK, passed through unquoted
	[ "${#1}" = 64 ] && [ -z "$(echo "$1" | sed 's/[0-9a-fA-F]//g')" ]
}

start() {
	local enabled ssid key device encryption ssid_hex psk_line country

	config_load mr1500x-wifi
	config_get_bool enabled wwan enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get ssid       wwan ssid
	config_get key        wwan key
	config_get device     wwan device 'wlan1-vxd'
	config_get encryption wwan encryption 'psk2'

	[ -n "$ssid" ] || { wlog "enabled but no ssid configured — not starting"; return 1; }
	[ -e "/sys/class/net/$device" ] || { wlog "$device does not exist — not starting"; return 1; }

	if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
		wlog "already running"
		return 0
	fi

	ssid_hex="$(printf '%s' "$ssid" | hexdump -v -e '/1 "%02x"')"
	[ -n "$ssid_hex" ] || { wlog "could not hex-encode the ssid"; return 1; }

	case "$encryption" in
	none|open)
		psk_line="	key_mgmt=NONE"
		;;
	*)
		[ -n "$key" ] || { wlog "encryption $encryption but no key set"; return 1; }
		if is_hex_psk "$key"; then
			psk_line="	key_mgmt=WPA-PSK
	psk=$key"
		else
			psk_line="	key_mgmt=WPA-PSK
	psk=\"$key\""
		fi
		;;
	esac

	umask 077
	cat > "$CONF" <<EOF
# generated by /etc/init.d/mr1500x-wwan — edits are lost on restart
ctrl_interface=/var/run/wpa_supplicant
ap_scan=1
network={
	ssid=$ssid_hex
	scan_ssid=1
$psk_line
}
EOF

	mkdir -p "$(dirname "$LOGF")"
	wlog "associating $device with \"$ssid\""
	# no -B on purpose; stdio redirected so this never holds a caller's channel
	/usr/sbin/wpa_supplicant -Dnl80211 -i "$device" -c "$CONF" \
		</dev/null >>"$LOGF" 2>&1 &
	echo $! > "$PIDF"

	# Wait for a real association before handing over to netifd, otherwise the
	# DHCP client burns its retries against a dead link.
	local i bssid
	i=0
	while [ $i -lt 30 ]; do
		sleep 1
		bssid="$(iwconfig "$device" 2>/dev/null | sed -n 's/.*Access Point: *\([0-9A-Fa-f:]*\).*/\1/p')"
		case "$bssid" in
		""|"Not-Associated"|"00:00:00:00:00:00") ;;
		*)
			wlog "associated with $bssid after ${i}s — bringing up wwan"
			# netifd will not adopt a phy80211 device on its own; hand it
			# over explicitly (see the header) before asking for DHCP.
			ubus call "network.interface.wwan" add_device \
				"{\"name\":\"$device\"}" 2>/dev/null \
				|| wlog "add_device failed — wwan will report NO_DEVICE"
			ifup wwan
			# The uplink only becomes visible in LuCI once netifd
			# re-runs its wireless setup: our reporting driver lists
			# the interfaces that are UP, and this one just came up.
			# It takes a down/up cycle — `reconf` does not re-run the
			# setup script. Safe because that driver's teardown is a
			# no-op. See /lib/netifd/wireless/mr1500x.sh.
			ubus -t 10 call network.wireless down >/dev/null 2>&1
			sleep 2
			ubus -t 10 call network.wireless up >/dev/null 2>&1
			return 0
			;;
		esac
		i=$((i + 1))
	done

	wlog "no association after ${i}s; supplicant left running (see $LOGF)"
	return 1
}

stop() {
	local device
	config_load mr1500x-wifi
	config_get device wwan device 'wlan1-vxd'

	ifdown wwan 2>/dev/null
	# Detach the external device again, so a later start() re-attaches a
	# device netifd is not already holding a stale reference to.
	ubus call "network.interface.wwan" remove_device \
		"{\"name\":\"$device\"}" 2>/dev/null
	if [ -f "$PIDF" ]; then
		kill "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null
		rm -f "$PIDF"
	fi
	rm -f "$CONF"
	return 0
}
